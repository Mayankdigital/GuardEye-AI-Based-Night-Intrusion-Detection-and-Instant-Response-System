# Raspberry Pi settings for AZURE mode
# (your laptop settings stay in config.env - this file does not change them)

# Your VM's DNS name, starting with wss://
SERVER_URL=wss://YOUR-LABEL.centralindia.cloudapp.azure.com

# Must match API_KEY in setup_azure_vm.sh
API_KEY=YOUR_AZURE_API_KEY

# Optional Telegram alert (leave empty to disable)
TG_TOKEN=
TG_CHAT=

# Tuning (optional)
MAX_FPS=6
JPEG_QUALITY=65
CONFIRM_FRAMES=3
COOLDOWN_SEC=15
