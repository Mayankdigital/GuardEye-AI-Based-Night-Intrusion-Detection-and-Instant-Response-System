# Raspberry Pi settings
# Replace 192.168.1.5 with your laptop's IP (shown when start_server.bat runs)
SERVER_URL=ws://YOUR_LAPTOP_IP:7860

# Must be the same as API_KEY in start_server.bat
API_KEY=YOUR_LAPTOP_API_KEY

# Optional Telegram alert (leave empty to disable)
TG_TOKEN=
TG_CHAT=

# Tuning (optional)
MAX_FPS=8
JPEG_QUALITY=70
CONFIRM_FRAMES=3
COOLDOWN_SEC=15
